import json
from decimal import Decimal, ROUND_HALF_UP
from datetime import datetime
import re

# Cargar datos
with open('entradas.json', 'r', encoding='utf-8') as f:
    data = json.load(f)

proveedores_homologados = set(data['proveedores_homologados'])
tipos_cambio = data['tipos_cambio']
presupuesto_inicial = {k: Decimal(str(v)) for k, v in data['presupuesto_inicial'].items()}
entradas = data['entradas']

# Copiar presupuesto
presupuesto = {k: v for k, v in presupuesto_inicial.items()}

# Ordenar entradas por fecha e id
entradas_ordenadas = sorted(entradas, key=lambda e: (e['fecha'], e['id']))

def parse_importe(texto):
    """Parsea un importe con moneda y devuelve el total en EUR con IVA"""
    
    # Detectar moneda
    if 'USD' in texto:
        moneda = 'USD'
    elif 'GBP' in texto:
        moneda = 'GBP'
    else:  # EUR o €
        moneda = 'EUR'
    
    # Detectar IVA
    tiene_iva = '+ IVA' in texto
    
    # Extraer número
    match = re.search(r'[\d.,]+', texto)
    numero_str = match.group(0)
    
    # Normalizar según moneda
    if moneda == 'EUR':
        # Formato español o plano
        if ',' in numero_str:
            # Formato español: quitar puntos, cambiar coma por punto
            numero_str = numero_str.replace('.', '').replace(',', '.')
    else:  # USD o GBP
        # Formato anglosajón: quitar comas
        numero_str = numero_str.replace(',', '')
    
    # Convertir a Decimal
    importe = Decimal(numero_str)
    
    # Aplicar tipo de cambio
    tipo = Decimal(str(tipos_cambio[moneda]))
    eur = (importe * tipo).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
    
    # Aplicar IVA
    if tiene_iva:
        total = (eur * Decimal('1.21')).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
    else:
        total = eur
    
    return total

# Procesar entradas
decisiones = {}
registros = {}

for entrada in entradas_ordenadas:
    id_entrada = entrada['id']
    tipo = entrada['tipo']
    
    if tipo == 'solicitud':
        fecha = entrada['fecha']
        departamento = entrada['departamento']
        proveedor = entrada['proveedor']
        categoria = entrada['categoria']
        urgente = entrada['urgente']
        
        # Parsear importe
        total = parse_importe(entrada['importe'])
        
        # Inicializar registro
        registro = {
            'id': id_entrada,
            'fecha': fecha,
            'departamento': departamento,
            'proveedor': proveedor,
            'categoria': categoria,
            'total': total,
            'urgente': urgente,
            'estado': None,
            'aprobador': None,
            'motivo': None,
            'revision_it': False
        }
        
        # REGLA 1: Proveedor homologado
        if proveedor not in proveedores_homologados:
            if categoria == 'seguridad' and urgente:
                registro['estado'] = 'escalada'
                registro['aprobador'] = 'direccion'
                registro['motivo'] = 'excepcion_seguridad'
            else:
                registro['estado'] = 'rechazada'
                registro['aprobador'] = None
                registro['motivo'] = 'proveedor_no_homologado'
        else:
            # REGLA 2: Presupuesto
            if total > presupuesto[departamento]:
                registro['estado'] = 'escalada'
                registro['aprobador'] = 'finanzas'
                registro['motivo'] = 'sin_presupuesto'
            else:
                # REGLA 3: Aprobada
                registro['estado'] = 'aprobada'
                registro['motivo'] = None
                
                # Calcular acumulado
                fecha_actual = datetime.fromisoformat(fecha)
                acumulado = total
                
                for id_prev, reg_prev in registros.items():
                    if (reg_prev['estado'] == 'aprobada' and
                        reg_prev['proveedor'] == proveedor and
                        reg_prev['departamento'] == departamento):
                        
                        fecha_prev = datetime.fromisoformat(reg_prev['fecha'])
                        dias_diff = (fecha_actual - fecha_prev).days
                        
                        if 0 <= dias_diff <= 7:
                            acumulado += reg_prev['total']
                
                # Determinar aprobador
                if acumulado <= Decimal('500'):
                    registro['aprobador'] = 'auto'
                elif acumulado <= Decimal('5000'):
                    registro['aprobador'] = 'jefe_departamento'
                else:
                    registro['aprobador'] = 'direccion'
                
                # Restar del presupuesto
                presupuesto[departamento] -= total
        
        # Calcular revision_it
        if categoria == 'software' and registro['estado'] in ['aprobada', 'escalada']:
            registro['revision_it'] = True
        
        registros[id_entrada] = registro
        
        # Añadir a decisiones
        decisiones[id_entrada] = {
            'estado': registro['estado'],
            'aprobador': registro['aprobador'],
            'motivo': registro['motivo'],
            'revision_it': registro['revision_it']
        }
    
    elif tipo == 'cancelacion':
        referencia = entrada['referencia']
        
        if referencia in registros:
            reg = registros[referencia]
            
            # Si estaba aprobada, devolver presupuesto
            if reg['estado'] == 'aprobada':
                presupuesto[reg['departamento']] += reg['total']
            
            # Marcar como cancelada
            reg['estado'] = 'cancelada'
            reg['aprobador'] = None
            reg['motivo'] = 'cancelada_por_solicitante'
            reg['revision_it'] = False

# Construir resultado
presupuesto_final = {k: float(presupuesto[k]) for k in presupuesto}

resultado = {
    'decisiones': decisiones,
    'presupuesto_final': presupuesto_final
}

print(json.dumps(resultado, ensure_ascii=False, indent=2))
