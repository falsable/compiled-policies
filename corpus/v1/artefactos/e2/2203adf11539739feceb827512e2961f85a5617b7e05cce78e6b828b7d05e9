import json
import re
from decimal import Decimal, ROUND_HALF_UP
from datetime import datetime

# Cargar datos
with open('entradas.json', 'r', encoding='utf-8') as f:
    data = json.load(f)

proveedores_homologados = set(data['proveedores_homologados'])
tipos_cambio = data['tipos_cambio']
presupuesto = {k: Decimal(str(v)) for k, v in data['presupuesto_inicial'].items()}
entradas = data['entradas']

# Registro interno de solicitudes procesadas
solicitudes = {}

def parse_importe(texto):
    # Detectar divisa
    if '€' in texto or 'EUR' in texto:
        divisa = 'EUR'
    elif 'USD' in texto:
        divisa = 'USD'
    elif 'GBP' in texto:
        divisa = 'GBP'
    else:
        divisa = 'EUR'
    
    # Detectar si tiene IVA
    tiene_iva = '+ IVA' in texto
    
    # Extraer el número
    match = re.search(r'[\d.,]+', texto)
    numero_str = match.group(0)
    
    # Normalizar el número según la divisa
    if divisa == 'EUR':
        if ',' in numero_str:
            numero_str = numero_str.replace('.', '').replace(',', '.')
    else:  # USD o GBP
        numero_str = numero_str.replace(',', '')
    
    importe = Decimal(numero_str)
    
    # Convertir a EUR
    tipo = Decimal(str(tipos_cambio[divisa]))
    eur = (importe * tipo).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
    
    # Aplicar IVA
    if tiene_iva:
        con_iva = (eur * Decimal('1.21')).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
    else:
        con_iva = eur
    
    return con_iva

# Ordenar las entradas
entradas_ordenadas = sorted(entradas, key=lambda e: (e['fecha'], e['id']))

# Identificar cancelaciones referenciadas
cancelaciones_referenciadas = set()
for entrada in entradas_ordenadas:
    if entrada['tipo'] == 'cancelacion':
        cancelaciones_referenciadas.add(entrada['referencia'])

# Procesar entradas
decisiones = {}

for entrada in entradas_ordenadas:
    if entrada['tipo'] == 'cancelacion':
        ref_id = entrada['referencia']
        
        if ref_id in solicitudes:
            solicitud = solicitudes[ref_id]
            if solicitud['estado'] == 'aprobada':
                presupuesto[solicitud['departamento']] += solicitud['con_iva']
            solicitudes[ref_id]['estado'] = 'cancelada'
            solicitudes[ref_id]['aprobador'] = None
            solicitudes[ref_id]['motivo'] = 'cancelada_por_solicitante'
            solicitudes[ref_id]['revision_it'] = False
            decisiones[ref_id] = {
                'estado': 'cancelada',
                'aprobador': None,
                'motivo': 'cancelada_por_solicitante',
                'revision_it': False
            }
    
    elif entrada['tipo'] == 'solicitud':
        id_solicitud = entrada['id']
        fecha_str = entrada['fecha']
        departamento = entrada['departamento']
        proveedor = entrada['proveedor']
        categoria = entrada['categoria']
        urgente = entrada['urgente']
        importe_texto = entrada['importe']
        
        con_iva = parse_importe(importe_texto)
        
        if id_solicitud in cancelaciones_referenciadas:
            estado = 'cancelada'
            aprobador = None
            motivo = 'cancelada_por_solicitante'
        else:
            if proveedor not in proveedores_homologados:
                if categoria == 'hardware' and urgente:
                    estado = 'escalada'
                    aprobador = 'direccion'
                    motivo = 'excepcion_seguridad'
                else:
                    estado = 'rechazada'
                    aprobador = None
                    motivo = 'proveedor_no_homologado'
            else:
                if con_iva > presupuesto[departamento]:
                    estado = 'escalada'
                    aprobador = 'finanzas'
                    motivo = 'sin_presupuesto'
                else:
                    estado = 'aprobada'
                    motivo = None
                    
                    fecha_obj = datetime.strptime(fecha_str, '%Y-%m-%d').date()
                    acumulado = con_iva
                    
                    for id_prev, sol_prev in solicitudes.items():
                        if sol_prev['estado'] == 'aprobada' and \
                           sol_prev['proveedor'] == proveedor and \
                           sol_prev['departamento'] == departamento:
                            fecha_prev_obj = sol_prev['fecha']
                            dias_diff = (fecha_obj - fecha_prev_obj).days
                            if 0 <= dias_diff <= 7:
                                acumulado += sol_prev['con_iva']
                    
                    if acumulado <= Decimal('500'):
                        aprobador = 'auto'
                    elif acumulado <= Decimal('5000'):
                        aprobador = 'jefe_departamento'
                    else:
                        aprobador = 'direccion'
                    
                    presupuesto[departamento] -= con_iva
        
        revision_it = (categoria == 'software' and estado in ['aprobada', 'escalada'])
        
        solicitudes[id_solicitud] = {
            'estado': estado,
            'aprobador': aprobador,
            'motivo': motivo,
            'revision_it': revision_it,
            'departamento': departamento,
            'proveedor': proveedor,
            'fecha': datetime.strptime(fecha_str, '%Y-%m-%d').date(),
            'con_iva': con_iva
        }
        
        decisiones[id_solicitud] = {
            'estado': estado,
            'aprobador': aprobador,
            'motivo': motivo,
            'revision_it': revision_it
        }

presupuesto_final = {dep: float(valor.quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)) 
                     for dep, valor in presupuesto.items()}

resultado = {
    'decisiones': decisiones,
    'presupuesto_final': presupuesto_final
}

print(json.dumps(resultado, ensure_ascii=False, indent=2))
