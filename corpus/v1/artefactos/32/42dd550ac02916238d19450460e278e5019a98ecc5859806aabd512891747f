import pandas as pd
import numpy as np
import json

def convert_numeric(x):
    if pd.isna(x):
        return np.nan
    x_str = str(x).strip().replace(',', '.')
    try:
        return float(x_str)
    except:
        return np.nan

# Step 1: Load CSV as strings
df = pd.read_csv('datos.csv', dtype=str, keep_default_na=False)

# Convert empty strings to NaN
for col in df.columns:
    df[col] = df[col].apply(lambda x: np.nan if (isinstance(x, str) and x.strip() == '') else x)

# Strip whitespace from id and region
df['id'] = df['id'].str.strip()
df['region'] = df['region'].str.strip()

# Step 2: Deduplicate by id (keep first)
df = df.drop_duplicates(subset='id', keep='first').reset_index(drop=True)

# Step 3: Convert numeric columns
numeric_cols = [col for col in df.columns if col not in ['id', 'region']]

for col in numeric_cols:
    df[col] = df[col].apply(convert_numeric)

# Step 4: Find eligible columns (max 20% missing)
frac_na = df[numeric_cols].isna().mean()
eligible = [col for col in numeric_cols if frac_na[col] <= 0.20]

# Step 5: Calculate Pearson correlation and find best pair
corr_matrix = df[eligible].corr(method='pearson')

max_abs_corr = -1
best_pair = None

for i in range(len(eligible)):
    for j in range(i + 1, len(eligible)):
        col_i = eligible[i]
        col_j = eligible[j]
        r = corr_matrix.loc[col_i, col_j]
        if not np.isnan(r):
            abs_r = abs(r)
            if abs_r > max_abs_corr:
                max_abs_corr = abs_r
                best_pair = sorted([col_i, col_j])

# Step 6: Detect anomalies by region
anomaly_ids = set()

for region in df['region'].unique():
    if pd.isna(region):
        continue
    
    region_df = df[df['region'] == region]
    
    for col in numeric_cols:
        values = region_df[col].dropna()
        
        if len(values) == 0:
            continue
        
        median = values.median()
        mad = (values - median).abs().median()
        
        # If MAD is 0, skip this column for this region
        if mad == 0:
            continue
        
        threshold = 3.5 * mad * 1.4826
        
        # Check each row in this region
        for idx, row in region_df.iterrows():
            val = row[col]
            if pd.notna(val) and abs(val - median) > threshold:
                anomaly_ids.add(row['id'])

# Step 7: Build and output result
anomaly_ids_sorted = sorted(list(anomaly_ids))

result = {
    'par': best_pair,
    'anomalias': anomaly_ids_sorted
}

print(json.dumps(result, ensure_ascii=False))
