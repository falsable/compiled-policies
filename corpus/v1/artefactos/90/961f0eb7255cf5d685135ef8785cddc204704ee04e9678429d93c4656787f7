import json
from datetime import datetime, timedelta

# Cargar datos
with open('entradas.json', 'r', encoding='utf-8') as f:
    data = json.load(f)

proveedores_homologados = data['proveedores_homologados']
tipos_cambio = data['tipos_cambio']
presupuesto = {k: float(v) for k, v in data['presupuesto_inicial'].items()}
entradas = data['entradas']

solicitudes = {}

def parse_importe(texto):
    """Parsea el texto de importe y devuelve el total en EUR."""
    # Detectar moneda
    if '€' in texto or 'EUR' in texto:
        moneda = 'EUR'
    elif 'USD' in texto:
        moneda = 'USD'
    elif 'GBP' in texto:
        moneda = 'GBP'
    else:
        raise ValueError(f"Moneda no detectada en: {texto}")
    
    # Detectar IVA
    tiene_iva = '+ IVA' in texto
    
    # Extraer el número (primer token)
    numero_str = texto.split()[0]
    
    # Normalizar según moneda
    if moneda == 'EUR':
        if ',' in numero_str:
            numero_str = numero_str.replace('.', '').replace(',', '.')
    else:  # USD, GBP
        numero_str = numero_str.replace(',', '')
    
    numero = float(numero_str)
    
    # Convertir a EUR
    eur = round(numero * tipos_cambio[moneda], 2)
    
    # Aplicar IVA si procede
    if tiene_iva:
        total = round(eur * 1.21, 2)
    else:
        total = eur
    
    return total

# Ordenar entradas por fecha e id
entradas_ordenadas = sorted(entradas, key=lambda e: (e['fecha'], e['id']))

# Procesar solicitudes
for entrada in entradas_ordenadas:
    if entrada['tipo'] == 'solicitud':
        id_sol = entrada['id']
        fecha = entrada['fecha']
        departamento = entrada['departamento']
        proveedor = entrada['proveedor']
        categoria = entrada['categoria']
        urgente = entrada['urgente']
        importe_texto = entrada['importe']
        
        # Parsear importe
        total = parse_importe(importe_texto)
        
        # Inicializar resultado
        estado = None
        aprobador = None
        motivo = None
        revision_it = False
        
        # Regla 1: Proveedor no homologado
        if proveedor not in proveedores_homologados:
            if categoria == 'seguridad' and urgente:
                estado = 'escalada'
                aprobador = 'direccion'
                motivo = 'excepcion_seguridad'
            else:
                estado = 'rechazada'
                aprobador = None
                motivo = 'proveedor_no_homologado'
        
        # Regla 2: Importe > presupuesto (solo si proveedor homologado)
        if estado is None and proveedor in proveedores_homologados:
            if total > presupuesto[departamento]:
                estado = 'escalada'
                aprobador = 'finanzas'
                motivo = 'sin_presupuesto'
        
        # Regla 3: Aprobada
        if estado is None:
            estado = 'aprobada'
            motivo = None
            
            # Calcular acumulado
            fecha_actual = datetime.fromisoformat(fecha).date()
            fecha_minima = fecha_actual - timedelta(days=7)
            
            acumulado = total
            for id_prev, sol_prev in solicitudes.items():
                if (sol_prev['estado'] == 'aprobada' and
                    sol_prev['proveedor'] == proveedor and
                    sol_prev['departamento'] == departamento):
                    fecha_prev = datetime.fromisoformat(sol_prev['fecha']).date()
                    if fecha_minima <= fecha_prev <= fecha_actual:
                        acumulado += sol_prev['total']
            
            # Asignar aprobador según acumulado
            if acumulado <= 500:
                aprobador = 'auto'
            elif acumulado <= 5000:
                aprobador = 'jefe_departamento'
            else:
                aprobador = 'direccion'
            
            # Descontar presupuesto
            presupuesto[departamento] = round(presupuesto[departamento] - total, 2)
        
        # Regla 4: revision_it
        if categoria == 'software' and estado in ['aprobada', 'escalada']:
            revision_it = True
        
        # Guardar solicitud
        solicitudes[id_sol] = {
            'fecha': fecha,
            'departamento': departamento,
            'proveedor': proveedor,
            'categoria': categoria,
            'total': total,
            'estado': estado,
            'aprobador': aprobador,
            'motivo': motivo,
            'revision_it': revision_it
        }

# Procesar cancelaciones
for entrada in entradas_ordenadas:
    if entrada['tipo'] == 'cancelacion':
        referencia = entrada['referencia']
        
        if referencia in solicitudes:
            sol = solicitudes[referencia]
            
            # Si estaba aprobada, devolver presupuesto
            if sol['estado'] == 'aprobada':
                presupuesto[sol['departamento']] = round(presupuesto[sol['departamento']] + sol['total'], 2)
            
            # Actualizar solicitud
            sol['estado'] = 'cancelada'
            sol['aprobador'] = None
            sol['motivo'] = 'cancelada_por_solicitante'
            sol['revision_it'] = False

# Construir salida
decisiones = {}
for id_sol, sol in solicitudes.items():
    decisiones[id_sol] = {
        'estado': sol['estado'],
        'aprobador': sol['aprobador'],
        'motivo': sol['motivo'],
        'revision_it': sol['revision_it']
    }

presupuesto_final = {dep: round(presupuesto[dep], 2) for dep in presupuesto}

resultado = {
    'decisiones': decisiones,
    'presupuesto_final': presupuesto_final
}

print(json.dumps(resultado, ensure_ascii=False, indent=2))
