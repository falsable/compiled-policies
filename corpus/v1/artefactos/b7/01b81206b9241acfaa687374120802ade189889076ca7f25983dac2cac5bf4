porte vuelve al presupuesto\ndel departamento. Las cancelaciones no aparecen en \"decisiones\".\n\nRedondeo a 2 decimales.","presupuesto_inicial":{"it":33300.0,"marketing":35100.0,"operaciones":33200.0,"rrhh":28300.0},"proveedores_homologados":["Acme Suministros","Iberdata","Norte Oficina","TecnoLevante","SegurPro"],"tipos_cambio":{"EUR":1.0,"GBP":1.17,"USD":0.92}}