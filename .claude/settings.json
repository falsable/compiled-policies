{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"C:/Users/Usuario/go/bin/a2dlc.exe\" hook claude",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit|Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"C:/Users/Usuario/go/bin/a2dlc.exe\" hook claude",
            "timeout": 1800,
            "type": "command"
          }
        ]
      }
    ]
  }
}
